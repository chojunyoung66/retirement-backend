# 데이터베이스 연결 URL
DATABASE_URL="postgresql://USER@localhost:5432/DB_NAME?schema=public"

# JWT 서명 시크릿 (충분히 긴 랜덤 문자열 사용)
JWT_SECRET=""

# 서버 포트
PORT=3000

# 실행 환경 (development | production | test)
NODE_ENV=development

# Google OAuth Client ID (ID Token의 aud 검증용, 공개값)
GOOGLE_CLIENT_ID=""

# CORS 허용 프론트엔드 오리진 (로컬: http://localhost:5173)
FRONTEND_ORIGIN="http://localhost:5173"
