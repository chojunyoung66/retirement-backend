generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SimulationType {
  HEALTH_INSURANCE
  ISA
  NATIONAL_PENSION
  IRP
  SEVERANCE_PAY
  UNEMPLOYMENT_BENEFIT
  HOUSING_PENSION
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String?
  googleSub    String?  @unique
  name         String
  profileImage String?
  // 계좌 잔액·과세구분 상세 저장 동의 시각 — 첫 계좌 저장 시 기록
  detailDataConsentAt DateTime?
  // USER | OPERATOR — 운영자 지정은 scripts/grant-operator.ts로만 한다
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  diagnosis              Diagnosis?
  simulationResults      SimulationResult[]
  portfolios             PensionPortfolio[]
  accountAssets          AccountAsset[]
  withdrawalScenarioSets WithdrawalScenarioSet[]
  reportSnapshots        ReportSnapshot[]
  payments               Payment[]
  reviewRequests         ReviewRequest[]
  executionPlans         ExecutionPlan[]
}

enum AccountAssetType {
  DC
  PENSION_SAVINGS
  IRP
  ISA
  BROKERAGE
  CASH
}

enum IrpSource {
  PERSONAL
  SEVERANCE
  MIXED
  UNKNOWN
}

model Diagnosis {
  id                   Int      @id @default(autoincrement())
  userId               Int      @unique
  householdType        String
  householdSize        Int      @default(1)
  birthYear            Int
  retirementYear       Int
  retirementMonth      Int?
  spouseBirthYear      Int?
  spouseRetirementYear Int?
  nationalPension      Int
  retirementPension    Int
  personalPension      Int
  housingPension       Int      @default(0)
  monthlyExpense       Int
  healthInsurance      Int      @default(0)
  privateInsurance     Int      @default(0)
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SimulationResult {
  id         Int            @id @default(autoincrement())
  userId     Int
  type       SimulationType
  version    Int            @default(1)
  status     String         @default("draft")
  inputData  Json
  outputData Json
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@index([createdAt])
}

model PensionPortfolio {
  id          Int      @id @default(autoincrement())
  userId      Int
  accountType String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items PensionPortfolioItem[]
  user  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PensionPortfolioItem {
  id          Int      @id @default(autoincrement())
  portfolioId Int
  symbol      String
  name        String
  allocation  Float
  createdAt   DateTime @default(now())

  portfolio PensionPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

// 계좌별 자산 — 계좌번호는 저장하지 않는다. 과세구분 합계를 뺀 나머지는 미확인 금액으로 본다.
model AccountAsset {
  id                       Int              @id @default(autoincrement())
  userId                   Int
  accountType              AccountAssetType
  accountName              String?
  institution              String?
  balance                  Int
  principalTaxCredited     Int              @default(0)
  principalNonDeductible   Int              @default(0)
  investmentGain           Int              @default(0)
  deferredRetirementIncome Int              @default(0)
  irpSource                IrpSource?
  pensionSavingsLegacy     Boolean?
  isaMaturityYm            String?
  verifiedAt               DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WithdrawalScenarioSet {
  id           Int      @id @default(autoincrement())
  userId       Int
  ruleVersion  String
  input        Json
  result       Json
  selectedType String?
  createdAt    DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports ReportSnapshot[]

  @@index([userId, createdAt])
}

// 실행계획 리포트 — 생성 시점의 시나리오 결과를 고정한다. 세트가 정리돼도 리포트는 남는다.
model ReportSnapshot {
  id            Int      @id @default(autoincrement())
  userId        Int
  scenarioSetId Int?
  scenarioType  String
  ruleVersion   String
  content       Json
  title         String?
  // 환불 판단용 — PDF·엑셀을 처음 받은 시각
  firstDownloadedAt DateTime?
  generatedAt   DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioSet    WithdrawalScenarioSet? @relation(fields: [scenarioSetId], references: [id], onDelete: SetNull)
  payment        Payment?
  reviewRequests ReviewRequest[]
  executionPlan  ExecutionPlan?

  @@index([userId, generatedAt])
}

enum PaymentStatus {
  READY
  PAID
  FAILED
  CANCELED
  REFUNDED
}

// 주문과 결제를 함께 담는다. 거래 기록 보관 의무 때문에 사용자·리포트가 지워져도 남긴다.
model Payment {
  id            Int           @id @default(autoincrement())
  orderId       String        @unique
  userId        Int?
  product       String        @default("REPORT")
  amount        Int
  status        PaymentStatus @default(READY)
  scenarioSetId Int?
  scenarioType  String
  paymentKey    String?       @unique
  method        String?
  approvedAt    DateTime?
  canceledAt    DateTime?
  cancelReason  String?
  receiptUrl    String?
  failureCode   String?
  // 결제로 리포트를 만든 시각 — 리포트를 지워도 같은 주문으로 다시 만들 수 없다
  consumedAt    DateTime?
  reportId      Int?          @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user   User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  report ReportSnapshot? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum ReviewStatus {
  REQUESTED
  IN_REVIEW
  ANSWERED
  CLOSED
  CANCELED
}

// 전문가 검토 요청 — 운영자는 동의받은 리포트 스냅샷만 본다
model ReviewRequest {
  id           Int          @id @default(autoincrement())
  userId       Int
  reportId     Int
  question     String
  consentAt    DateTime
  status       ReviewStatus @default(REQUESTED)
  answer       String?
  answeredAt   DateTime?
  operatorNote String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  report ReportSnapshot @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([reportId])
}

// 리포트 기준 100일 실행 체크리스트
model ExecutionPlan {
  id        Int      @id @default(autoincrement())
  userId    Int
  reportId  Int      @unique
  startDate DateTime
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  report ReportSnapshot @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([userId])
}
