generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SimulationType {
  HEALTH_INSURANCE
  ISA
  NATIONAL_PENSION
  IRP
  SEVERANCE_PAY
  UNEMPLOYMENT_BENEFIT
  HOUSING_PENSION
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String?
  googleSub    String?  @unique
  name         String
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  diagnosis              Diagnosis?
  simulationResults      SimulationResult[]
  portfolios             PensionPortfolio[]
  accountAssets          AccountAsset[]
  withdrawalScenarioSets WithdrawalScenarioSet[]
  reportSnapshots        ReportSnapshot[]
}

enum AccountAssetType {
  DC
  PENSION_SAVINGS
  IRP
  ISA
  BROKERAGE
  CASH
}

enum IrpSource {
  PERSONAL
  SEVERANCE
  MIXED
  UNKNOWN
}

model Diagnosis {
  id                   Int      @id @default(autoincrement())
  userId               Int      @unique
  householdType        String
  householdSize        Int      @default(1)
  birthYear            Int
  retirementYear       Int
  spouseBirthYear      Int?
  spouseRetirementYear Int?
  nationalPension      Int
  retirementPension    Int
  personalPension      Int
  housingPension       Int      @default(0)
  monthlyExpense       Int
  healthInsurance      Int      @default(0)
  privateInsurance     Int      @default(0)
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SimulationResult {
  id         Int            @id @default(autoincrement())
  userId     Int
  type       SimulationType
  version    Int            @default(1)
  status     String         @default("draft")
  inputData  Json
  outputData Json
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@index([createdAt])
}

model PensionPortfolio {
  id          Int      @id @default(autoincrement())
  userId      Int
  accountType String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items PensionPortfolioItem[]
  user  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PensionPortfolioItem {
  id          Int      @id @default(autoincrement())
  portfolioId Int
  symbol      String
  name        String
  allocation  Float
  createdAt   DateTime @default(now())

  portfolio PensionPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

// 계좌별 자산 — 계좌번호는 저장하지 않는다. 과세구분 합계를 뺀 나머지는 미확인 금액으로 본다.
model AccountAsset {
  id                       Int              @id @default(autoincrement())
  userId                   Int
  accountType              AccountAssetType
  accountName              String?
  institution              String?
  balance                  Int
  principalTaxCredited     Int              @default(0)
  principalNonDeductible   Int              @default(0)
  investmentGain           Int              @default(0)
  deferredRetirementIncome Int              @default(0)
  irpSource                IrpSource?
  pensionSavingsLegacy     Boolean?
  isaMaturityYm            String?
  verifiedAt               DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WithdrawalScenarioSet {
  id           Int      @id @default(autoincrement())
  userId       Int
  ruleVersion  String
  input        Json
  result       Json
  selectedType String?
  createdAt    DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports ReportSnapshot[]

  @@index([userId, createdAt])
}

// 실행계획 리포트 — 생성 시점의 시나리오 결과를 고정한다. 세트가 정리돼도 리포트는 남는다.
model ReportSnapshot {
  id            Int      @id @default(autoincrement())
  userId        Int
  scenarioSetId Int?
  scenarioType  String
  ruleVersion   String
  content       Json
  generatedAt   DateTime @default(now())

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioSet WithdrawalScenarioSet? @relation(fields: [scenarioSetId], references: [id], onDelete: SetNull)

  @@index([userId, generatedAt])
}
