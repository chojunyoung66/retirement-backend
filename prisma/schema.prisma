generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SimulationType {
  HEALTH_INSURANCE
  ISA
  NATIONAL_PENSION
  IRP
  SEVERANCE_PAY
  UNEMPLOYMENT_BENEFIT
  HOUSING_PENSION
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String?
  googleSub    String?  @unique
  name         String
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  diagnosis         Diagnosis?
  simulationResults SimulationResult[]
  portfolios        PensionPortfolio[]
}

model Diagnosis {
  id                   Int      @id @default(autoincrement())
  userId               Int      @unique
  householdType        String
  householdSize        Int      @default(1)
  birthYear            Int
  retirementYear       Int
  spouseBirthYear      Int?
  spouseRetirementYear Int?
  nationalPension      Int
  retirementPension    Int
  personalPension      Int
  housingPension       Int      @default(0)
  monthlyExpense       Int
  healthInsurance      Int      @default(0)
  privateInsurance     Int      @default(0)
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SimulationResult {
  id         Int            @id @default(autoincrement())
  userId     Int
  type       SimulationType
  version    Int            @default(1)
  status     String         @default("draft")
  inputData  Json
  outputData Json
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@index([createdAt])
}

model PensionPortfolio {
  id          Int      @id @default(autoincrement())
  userId      Int
  accountType String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items PensionPortfolioItem[]
  user  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PensionPortfolioItem {
  id          Int      @id @default(autoincrement())
  portfolioId Int
  symbol      String
  name        String
  allocation  Float
  createdAt   DateTime @default(now())

  portfolio PensionPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}
